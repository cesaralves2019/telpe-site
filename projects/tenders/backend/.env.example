# --- database (MongoDB Atlas free tier, or local docker) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=telpe_tenders

# --- Telegram (@BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# --- WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_VERIFY_TOKEN=telpe-verify
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_ALERT=tender_alert
WHATSAPP_TEMPLATE_DIGEST=tender_digest
WHATSAPP_TEMPLATE_REMINDER=deadline_reminder
WHATSAPP_TEMPLATE_LANG=en

# --- summaries (optional) ---
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-4-5-20251001

# --- schedule (local time in TIMEZONE) ---
TIMEZONE=Europe/Dublin
DAILY_SEND_AT=08:05
WEEKLY_SEND_AT=08:00
REMINDERS_AT=09:00
FETCH_EVERY_MINUTES=60

# --- matching ---
MIN_FIT=70
DAILY_LIMIT=1
DIGEST_SIZE=4
